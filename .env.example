# ========================================
# CONFIGURATION EXEMPLE - Site Web Digiqo
# ========================================
# Copier ce fichier vers .env.local et remplacer les valeurs

# Configuration Airtable
AIRTABLE_PAT=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_ID=your_testimonials_table_id
AIRTABLE_AUDITS_TABLE_ID=your_audits_table_id

# YouTube Data API v3 - témoignages vidéo clients (server-side only)
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_UPLOADS_PLAYLIST_ID=your_channel_uploads_playlist_id

# Google Drive API v3 - dossier des réalisations vidéo (server-side only)
# Réutilise YOUTUBE_API_KEY ci-dessus (la clé couvre aussi Drive API).
DRIVE_REALISATIONS_FOLDER_ID=your_drive_folder_id

# URL de base pour les liens (production)
NEXT_PUBLIC_BASE_URL=https://digiqo.re

# Token HubSpot pour l'intégration CRM
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token

# Google Analytics 4
# ID de mesure pour le tracking des visiteurs et conversions
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-NFN3PN0GLY
# Google Drive API v3 - dossier des créatifs clients (server-side only)
# Réutilise YOUTUBE_API_KEY ci-dessus (la clé couvre aussi Drive API).
DRIVE_CREATIFS_FOLDER_ID=your_drive_folder_id
